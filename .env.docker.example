# Copy this file to .env in the repository root, then change JWT_SECRET.
# Docker Compose reads .env for the values in docker-compose.yaml.
# These are placeholders. None of them are real credentials.
#
#   copy .env.docker.example .env          (Windows Command Prompt)
#   Copy-Item .env.docker.example .env     (PowerShell)
#   cp .env.docker.example .env            (Git Bash)
#
# Generate a secret (Git Bash, or any shell with OpenSSL):
#   openssl rand -base64 32
# PowerShell, if OpenSSL is not on PATH:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))

# === Required ===
# Signs login cookies. Set this once, before the first registration.
# Changing it later logs everyone out.
JWT_SECRET=replace-with-the-output-of-openssl-rand-base64-32

# URL you type in the browser. Protocol, host, and port must match.
MAIN_URL=http://localhost:4007
FRONTEND_URL=http://localhost:4007
NEXT_PUBLIC_BACKEND_URL=http://localhost:4007/api
BACKEND_INTERNAL_URL=http://localhost:3000

# Bind address and host port for the web UI. 127.0.0.1 keeps it on this PC.
POSTIZ_BIND=127.0.0.1
POSTIZ_PORT=4007

# Local database password. Use letters, numbers, and hyphen only.
POSTIZ_POSTGRES_PASSWORD=postiz-password

# Leave registration open until you create the first account, then set true
# and run: docker compose up -d
DISABLE_REGISTRATION=false

# Schedules the background recovery workflow. Leave true.
RUN_CRON=true
IS_GENERAL=true

# Local uploads. Cloudflare R2 is optional and not required to start.
STORAGE_PROVIDER=local

# === Stripe ===
# Leave every Stripe variable empty. A non-empty publishable key enables
# hosted-plan channel and post limits. This private instance does not use them.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_SIGNING_KEY=
STRIPE_SIGNING_KEY_CONNECT=

# === Optional: your own social app credentials ===
# Postiz talks to each network with an app you create on that network.
# Empty values are valid. The channel stays unavailable until you fill them in
# and run: docker compose up -d
# Callback URL pattern: http://localhost:4007/integrations/social/<provider>
# Example for Mastodon: http://localhost:4007/integrations/social/mastodon

X_URL=
X_API_KEY=
X_API_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
DRIBBBLE_CLIENT_ID=
DRIBBBLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN_ID=
SLACK_ID=
SLACK_SECRET=
SLACK_SIGNING_SECRET=
MASTODON_URL=https://mastodon.social
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=

# Optional. AI features stay off when this is empty. Scheduling does not need it.
OPENAI_API_KEY=
